# Copy the relevant values to .env.local. Never commit credentials.
# npm run setup:local creates APP_URL and a random local encryption key.
APP_URL=http://localhost:3000
RELAY_ENCRYPTION_KEY=
# Optional: SQLite location on a persistent volume (Node.js 24+).
# RELAY_DATABASE_PATH=/absolute/path/to/relay.sqlite

META_APP_ID=
META_APP_SECRET=

# Shopify app credentials. Never ask merchants for tokens.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Official install/listing link from Shopify's app distribution settings. No store address is requested in Relay.
SHOPIFY_INSTALL_URL=
# Local development store only, for server-side test credentials.
SHOPIFY_SHOP=

# Only for local proof scripts; obtain the account ID from /api/auth/me.
# RELAY_USER_ID=
